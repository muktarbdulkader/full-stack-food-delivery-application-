# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/foodhub

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Admin Registration Secret Code
ADMIN_SECRET_CODE=FOODHUB2024

# Payment API Keys (Optional - for production)
# TELEBIRR_APP_ID=your-telebirr-app-id
# TELEBIRR_APP_KEY=your-telebirr-app-key
# MPESA_CONSUMER_KEY=your-mpesa-consumer-key
# MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
# CBE_API_KEY=your-cbe-api-key

# Email Configuration (Optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email
# SMTP_PASS=your-password
